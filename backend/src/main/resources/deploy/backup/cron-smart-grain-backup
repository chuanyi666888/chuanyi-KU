###############################################################################
# 智慧粮库 - 备份恢复系统定时任务配置
# 部署位置: /etc/cron.d/smart-grain-backup
# 用户: root 或 smartgrain（需有相应权限）
# 日志: /var/log/smartgrain/cron-backup.log
###############################################################################

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# 环境变量（按实际环境修改）
# 数据库密码请放在 /etc/profile.d/smartgrain-backup.sh 中加载，不要在此明文

# ===== MySQL 备份 =====
# 每日凌晨 02:00 全量备份
0  2 * * *   smartgrain  /opt/smartgrain/scripts/backup/mysql-backup.sh full       >> /var/log/smartgrain/cron-backup.log 2>&1

# 每 6 小时增量备份（binlog）: 00:30 / 06:30 / 12:30 / 18:30
30 */6 * * * smartgrain  /opt/smartgrain/scripts/backup/mysql-backup.sh incremental >> /var/log/smartgrain/cron-backup.log 2>&1

# ===== KingbaseES 备份（国产化环境启用）=====
# 每日凌晨 02:30 全量备份
30 2 * * *   smartgrain  /opt/smartgrain/scripts/backup/kingbase-backup.sh full       >> /var/log/smartgrain/cron-backup.log 2>&1

# 每 6 小时增量备份（WAL）: 03:00 / 09:00 / 15:00 / 21:00
0  */6 * * * smartgrain  /opt/smartgrain/scripts/backup/kingbase-backup.sh incremental >> /var/log/smartgrain/cron-backup.log 2>&1

# 每周一凌晨 03:30 物理基础备份（用于 PITR）
30 3 * * 1   smartgrain  /opt/smartgrain/scripts/backup/kingbase-backup.sh basebackup    >> /var/log/smartgrain/cron-backup.log 2>&1

# ===== 自动清理 =====
# 每日凌晨 04:00 清理过期备份
0  4 * * *   smartgrain  /opt/smartgrain/scripts/backup/mysql-backup.sh    cleanup >> /var/log/smartgrain/cron-backup.log 2>&1
15 4 * * *   smartgrain  /opt/smartgrain/scripts/backup/kingbase-backup.sh cleanup >> /var/log/smartgrain/cron-backup.log 2>&1

# ===== 完整性校验 =====
# 每日 04:30 校验今日备份
30 4 * * *   smartgrain  /opt/smartgrain/scripts/backup/mysql-backup.sh    verify  >> /var/log/smartgrain/cron-backup.log 2>&1
35 4 * * *   smartgrain  /opt/smartgrain/scripts/backup/kingbase-backup.sh verify  >> /var/log/smartgrain/cron-backup.log 2>&1

# ===== 异地容灾同步 =====
# 每日凌晨 05:00 rsync 同步到远程备份服务器
0  5 * * *   smartgrain  /opt/smartgrain/scripts/backup/rsync-sync.sh all >> /var/log/smartgrain/cron-backup.log 2>&1

# ===== 恢复演练（每月 1 日 06:00 自动演练）=====
# 演练使用隔离的测试数据库（DRILL_DB_PORT=3307），不影响生产
0  6 1 * *   smartgrain  /opt/smartgrain/scripts/backup/restore-drill.sh mysql    >> /var/log/smartgrain/cron-backup.log 2>&1
30 6 1 * *   smartgrain  /opt/smartgrain/scripts/backup/restore-drill.sh kingbase >> /var/log/smartgrain/cron-backup.log 2>&1

###############################################################################
# 备份保留策略
# -----------------------------------------------------------------------------
# | 分类       | 频率       | 保留时间   | 说明
# |-----------|-----------|-----------|-------------------------------------------
# | daily     | 每日       | 7 天      | 日常备份，覆盖最近一周
# | weekly    | 每周日     | 4 周      | 周末备份，覆盖最近一个月
# | monthly   | 每月 1 日   | 6 个月    | 月初备份，覆盖最近半年
# | binlog/wal| 每 6 小时   | 3 天      | 增量备份，用于 PITR（按时间点恢复）
# | base      | 每周一     | 4 周      | KingbaseES 物理基础备份
###############################################################################
